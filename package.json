{
  "name": "waldrick-medical-records",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "dev": "concurrently -k -n ng,cf -c cyan,magenta \"ng serve\" \"wrangler dev\"",
    "build": "ng build",
    "worker:dev": "wrangler dev",
    "deploy": "ng build && wrangler deploy",
    "cf-typegen": "wrangler types",
    "db:migrate:local": "wrangler d1 migrations apply waldrick-medical --local",
    "db:migrate:remote": "wrangler d1 migrations apply waldrick-medical --remote",
    "db:tables:local": "wrangler d1 execute waldrick-medical --local --command \"SELECT name FROM sqlite_master WHERE type='table'\""
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "dependencies": {
    "@angular/animations": "^20.3.0",
    "@angular/cdk": "^20.2.14",
    "@angular/common": "^20.3.0",
    "@angular/compiler": "^20.3.0",
    "@angular/core": "^20.3.0",
    "@angular/forms": "^20.3.0",
    "@angular/material": "^20.2.14",
    "@angular/platform-browser": "^20.3.0",
    "@angular/router": "^20.3.0",
    "hono": "^4.6.14",
    "jose": "^5.9.6",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/build": "^20.3.31",
    "@angular/cli": "^20.3.31",
    "@angular/compiler-cli": "^20.3.0",
    "@cloudflare/workers-types": "^4.20241205.0",
    "concurrently": "^9.1.0",
    "typescript": "~5.9.2",
    "wrangler": "^4.107.0"
  }
}
